@model IEnumerable<TesteEndereco.Web.Models.Endereco>

@{
    ViewData["Title"] = "Meus Endereços";
}

<h2>Meus Endereços</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Endereço</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>CEP</th>
            <th>Logradouro</th>
            <th>Número</th>
            <th>Bairro</th>
            <th>Cidade</th>
            <th>UF</th>
            <th>Complemento</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var endereco in Model)
        {
            <tr>
                <td>@endereco.Cep</td>
                <td>@endereco.Logradouro</td>
                <td>@endereco.Numero</td>
                <td>@endereco.Bairro</td>
                <td>@endereco.Cidade</td>
                <td>@endereco.Uf</td>
                <td>@endereco.Complemento</td>
            </tr>
        }
    </tbody>
</table>
